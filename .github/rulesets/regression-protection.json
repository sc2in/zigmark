{
  "name": "regression-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": ["~DEFAULT_BRANCH"]
    }
  },
  "rules": [
    { "type": "deletion" },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          { "context": "build (x86_64-linux)" },
          { "context": "build (aarch64-linux)" },
          { "context": "wasm" },
          { "context": "bench-regression" }
        ]
      }
    }
  ],
  "bypass_actors": []
}
